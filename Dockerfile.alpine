# Stage 1: Builder
FROM python:3.12-alpine AS builder

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Set working directory
WORKDIR /app

# Install build dependencies
RUN apk add --no-cache build-base python3-dev musl-dev linux-headers

# Enable bytecode compilation
ENV UV_COMPILE_BYTECODE=1

# Copy dependencies first
COPY pyproject.toml uv.lock ./

# Install dependencies without the project
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project

# Copy source
COPY . .

# Install project
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

# Stage 2: Final
FROM python:3.12-alpine

ARG USERNAME=appuser
ARG UID=1000
ARG GID=1000

# Create a non-root user
RUN addgroup -g $GID $USERNAME \
    && adduser -D -u $UID -G $USERNAME $USERNAME

# Set working directory
WORKDIR /app

# Copy venv from builder
COPY --from=builder --chown=$USERNAME:$USERNAME /app/.venv /app/.venv

# Set environment variables
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Install runtime dependencies
# ffmpeg for video processing, libjpeg-turbo and zlib for Pillow
RUN apk add --no-cache ffmpeg libjpeg-turbo zlib

# Switch to non-root user
USER $USERNAME

# Define entrypoint
ENTRYPOINT ["vhcalc"]
CMD ["-", "-"]
