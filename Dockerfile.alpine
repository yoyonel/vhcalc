FROM python:3.12-alpine AS builder

# Set environment variables
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Install system dependencies for building (if needed)
RUN apk add --no-cache build-base

# Install dependencies
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev

# Copy source code
COPY . .

# Install the project
RUN uv sync --frozen --no-dev

# Final stage
FROM python:3.12-alpine

# Set environment variables
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    IMAGEIO_FFMPEG_EXE=/usr/bin/ffmpeg

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache libmediainfo ffmpeg

# Create a non-root user
RUN addgroup -S vhcalc && adduser -S vhcalc -G vhcalc -u 1000

# Copy the environment and application from the builder stage
COPY --from=builder --chown=vhcalc:vhcalc /app /app

# Switch to the non-root user
USER vhcalc

ENTRYPOINT ["vhcalc"]
CMD ["-", "-"]
