FROM python:3.12-slim-bookworm AS builder

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Compile bytecode
ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy

WORKDIR /app

# Install dependencies
# Using --mount to leverage cache
COPY pyproject.toml uv.lock ./
# Need README for package metadata (if referenced in pyproject.toml)
COPY docs/README.md ./docs/README.md
# Install dependencies (without project)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-install-project --no-editable

# Need source code to install the project
COPY vhcalc ./vhcalc

# Install libmediainfo for copying later
RUN apt-get update && \
    apt-get install -y --no-install-recommends libmediainfo0v5 libzen0v5 && \
    rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --no-editable

FROM gcr.io/distroless/python3-debian12

# Copy libmediainfo and its primary dependencies
# Note: libcurl and deeper dependencies might still be missing in distroless,
# making this variant experimental.
COPY --from=builder /usr/lib/x86_64-linux-gnu/libmediainfo.so.0 /usr/lib/x86_64-linux-gnu/libmediainfo.so.0
COPY --from=builder /usr/lib/x86_64-linux-gnu/libzen.so.0 /usr/lib/x86_64-linux-gnu/libzen.so.0
COPY --from=builder /usr/lib/x86_64-linux-gnu/libtinyxml2.so.10 /usr/lib/x86_64-linux-gnu/libtinyxml2.so.10
COPY --from=builder /usr/lib/x86_64-linux-gnu/libmms.so.0 /usr/lib/x86_64-linux-gnu/libmms.so.0
COPY --from=builder /usr/lib/x86_64-linux-gnu/libcurl-gnutls.so.4 /usr/lib/x86_64-linux-gnu/libcurl-gnutls.so.4

WORKDIR /app

# Copy site-packages from builder
COPY --from=builder /app/.venv/lib/python3.12/site-packages /app/site-packages

# Set PYTHONPATH
ENV PYTHONPATH=/app/site-packages

# Entrypoint
ENTRYPOINT ["/usr/bin/python3", "-m", "vhcalc.app"]
CMD ["-", "-"]
